# Configuração do ambiente local. Copie para .env e ajuste.
#
# O .env NÃO é versionado: ele aponta para a sua pasta de registros, que tem
# dado de pessoa e nunca entra no repositório.

# Pasta que a ingestão varre, montada somente leitura no container.
# Aceita caminho do Windows com barra normal.
PASTA_REGISTROS=C:/caminho/para/seus/registros

# E-mail do coordenador, usado para criar o tenant na primeira execução.
COORDENADOR_EMAIL=voce@exemplo.com

# Seu nome EXATAMENTE como o Tactiq e o Gemini o escrevem no cabeçalho
# `Participants:` — é por ele que a ingestão sabe quais falas são suas.
#
# Deixar em branco não quebra a carga: ela tenta os outros participantes até um
# resolver, e o coordenador nunca resolve porque não está no cadastro de
# pessoas. Mas sem o nome, nenhuma fala sai marcada como sua, e a transcrição
# fica sem saber quem falou o quê.
COORDENADOR_NOME=Seu Nome Completo
